# Names only — real values live in Netlify: Site configuration → Environment variables.
# For local `netlify dev`, copy to .env (git-ignored) and fill in.

# AI agent (Google Gemini). Key from https://aistudio.google.com → Get API key
AI_AGENT_KEY=
# Optional: API base URL override (proxy / Vertex endpoint)
AI_AGENT_URL=
# Optional model overrides (defaults: gemini-pro-latest, gemini-3.1-flash-image)
AI_TEXT_MODEL=
AI_IMAGE_MODEL=

# GitHub
GITHUB_REPO=rwxlog/abuaaisha-test
# Fine-grained token: this repo only, Contents read/write, with an expiry date
GITHUB_BOT_TOKEN=

# Comma-separated GitHub usernames allowed to generate drafts
ALLOWED_EDITORS=tairan11
# Optional: generations per editor per 24 h (default 20)
AI_DAILY_LIMIT=
