# Names only — real values live in Netlify: Site configuration → Environment variables.
# For local `netlify dev`, copy to .env (git-ignored) and fill in.

# AI agent (Google Gemini). Key from https://aistudio.google.com → Get API key
AI_AGENT_KEY=
# Optional: API base URL override (proxy / Vertex endpoint)
AI_AGENT_URL=
# Optional model overrides. Defaults are current Flash models with automatic
# fallback: free-tier keys have no quota for Pro-class models (gemini-3.1-pro
# answers 429 "limit: 0") and older names (gemini-2.5-flash) now answer 404.
# The key is trimmed and surrounding quotes are stripped before use.
# AI_TEXT_MODEL=gemini-3.8-flash
# AI_TEXT_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash
# AI_IMAGE_MODEL=gemini-3.1-flash-image

# GitHub
GITHUB_REPO=Progressive-Byte/abuaaisha-blog
# Fine-grained token: this repo only, Contents read/write, with an expiry date
GITHUB_BOT_TOKEN=

# Comma-separated GitHub usernames allowed to generate drafts.
# The repository owner (from GITHUB_REPO), rwxlog and MujahidEmon are always
# allowed; list any other editors here.
ALLOWED_EDITORS=
# Optional: generations per editor per 24 h (default 20)
AI_DAILY_LIMIT=
